<Window x:Class="DynamicIsland.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dynamic Island"
        Width="580" Height="280"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{x:Null}"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        AllowDrop="True"
        Loaded="Window_Loaded"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <!-- Fluent Icon Font Style (Segoe Fluent Icons với fallback sang Segoe MDL2 Assets) -->
        <Style x:Key="FluentIconStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="IslandButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="15" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#44FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlayButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="20" Width="40" Height="40">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E2E2E2"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#B0B0B0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Rounded Pill ProgressBar Style (Bo tròn 4 góc chuẩn Apple) -->
        <Style x:Key="RoundedProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="10"/>
            <Setter Property="Background" Value="#28282C"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <!-- Background Track bo tròn 4 góc -->
                            <Border Background="{TemplateBinding Background}" CornerRadius="5"/>
                            
                            <!-- Indicator Track có bo tròn 4 góc -->
                            <Grid x:Name="PART_Track" ClipToBounds="True">
                                <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left" CornerRadius="5"/>
                            </Grid>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern iOS Pill Slider Style for Control Center -->
        <Style x:Key="PillSliderStyle" TargetType="Slider">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <!-- Background Track bo tròn 4 góc -->
                            <Border Height="14" Background="#28282C" CornerRadius="7" ClipToBounds="True"/>
                            
                            <!-- Track & Thumb -->
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate>
                                                <Border Height="14" Background="{TemplateBinding Foreground}" CornerRadius="7"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate>
                                                <Border Height="14" Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="20" Height="20" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate>
                                                <Ellipse Fill="#FFFFFF" Width="20" Height="20">
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.45" Color="#000000"/>
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Context Menu for Quick Control -->
    <Window.ContextMenu>
        <ContextMenu x:Name="IslandContextMenu" Background="#141416" Foreground="#EDEDED" BorderBrush="#2D2D33" Opened="IslandContextMenu_Opened" Closed="IslandContextMenu_Closed">
            <MenuItem Header="Cài đặt (Settings)" Click="MenuSettings_Click" FontWeight="SemiBold" InputGestureText="Ctrl+,">
                <MenuItem.Icon>
                    <TextBlock Style="{StaticResource FluentIconStyle}" Text="&#xE713;" FontSize="13" Foreground="#AEAEB2"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem x:Name="MenuAutoHide" Header="Tự động ẩn (Auto-Hide)" IsCheckable="True" Click="MenuAutoHide_Click">
                <MenuItem.Icon>
                    <TextBlock Style="{StaticResource FluentIconStyle}" Text="&#xE7B3;" FontSize="13" Foreground="#AEAEB2"/>
                </MenuItem.Icon>
            </MenuItem>
            <Separator Background="#2D2D33"/>
            <MenuItem x:Name="MenuMonitors" Header="Chọn Màn hình (Display)">
                <MenuItem.Icon>
                    <TextBlock Style="{StaticResource FluentIconStyle}" Text="&#xE7F4;" FontSize="13" Foreground="#AEAEB2"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Chuyển sang màn hình khác" Click="MenuSwitchNextMonitor_Click" InputGestureText="F9">
                <MenuItem.Icon>
                    <TextBlock Style="{StaticResource FluentIconStyle}" Text="&#xE895;" FontSize="13" Foreground="#AEAEB2"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Căn giữa màn hình hiện tại" Click="MenuResetPosition_Click">
                <MenuItem.Icon>
                    <TextBlock Style="{StaticResource FluentIconStyle}" Text="&#xE7C1;" FontSize="13" Foreground="#AEAEB2"/>
                </MenuItem.Icon>
            </MenuItem>
            <Separator Background="#2D2D33"/>
            <MenuItem Header="Bật / Thu nhỏ Expanded View" Click="MenuToggleExpand_Click">
                <MenuItem.Icon>
                    <TextBlock Style="{StaticResource FluentIconStyle}" Text="&#xE740;" FontSize="13" Foreground="#AEAEB2"/>
                </MenuItem.Icon>
            </MenuItem>
            <Separator Background="#2D2D33"/>
            <MenuItem Header="Thoát Dynamic Island" Click="MenuExit_Click">
                <MenuItem.Icon>
                    <TextBlock Style="{StaticResource FluentIconStyle}" Text="&#xE711;" FontSize="13" Foreground="#AEAEB2"/>
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </Window.ContextMenu>

    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <!-- Vùng cảm biến viền trên cùng màn hình khi Island đang ẩn -->
        <Border x:Name="TopEdgeTrigger"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Height="8"
                Width="340"
                Background="#01000000"
                MouseEnter="TopEdgeTrigger_MouseEnter"/>

        <!-- Khối chứa Island hỗ trợ hiệu ứng trượt ẩn/hiện -->
        <Grid x:Name="IslandRoot" HorizontalAlignment="Stretch" VerticalAlignment="Top">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="IslandTransform" Y="0"/>
            </Grid.RenderTransform>

            <!-- Lớp đổ bóng riêng biệt: Không chứa con nên bóng bo tròn 100% theo viên thuốc -->
            <Border x:Name="IslandShadow"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,2,0,0"
                Width="200"
                Height="36"
                CornerRadius="18"
                Background="#080809">
            <Border.Effect>
                <DropShadowEffect x:Name="IslandDropShadow" BlurRadius="20" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.6"/>
            </Border.Effect>
        </Border>

        <!-- Viên thuốc hiển thị nội dung -->
        <Border x:Name="IslandContainer"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,2,0,0"
                Width="200"
                Height="36"
                CornerRadius="18"
                Background="#080809"
                BorderBrush="#2A2A30"
                BorderThickness="1"
                ClipToBounds="True"
                Cursor="Hand"
                AllowDrop="True"
                PreviewDragEnter="IslandContainer_PreviewDragEnter"
                PreviewDragOver="IslandContainer_PreviewDragOver"
                PreviewDragLeave="IslandContainer_PreviewDragLeave"
                PreviewDrop="IslandContainer_PreviewDrop"
                MouseEnter="IslandContainer_MouseEnter"
                MouseLeave="IslandContainer_MouseLeave"
                PreviewMouseWheel="IslandContainer_PreviewMouseWheel"
                PreviewMouseLeftButtonDown="IslandContainer_PreviewMouseLeftButtonDown"
                PreviewMouseMove="IslandContainer_PreviewMouseMove"
                PreviewMouseLeftButtonUp="IslandContainer_PreviewMouseLeftButtonUp">

            <Grid>
                <!-- 1. COMPACT IDLE VIEW -->
                <Grid x:Name="CompactIdleView" Visibility="Visible" Margin="14,0,14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Clock -->
                    <StackPanel x:Name="ClockPanel" Orientation="Horizontal" VerticalAlignment="Center" Grid.Column="0">
                        <TextBlock x:Name="TxtClock" Text="12:00" Foreground="#F0F0F0" FontWeight="SemiBold" FontSize="13" FontFamily="Segoe UI Variable Display, Segoe UI"/>
                    </StackPanel>

                    <!-- Privacy Indicators (Đèn báo bảo mật chuẩn macOS/iOS: Cam = Mic, Xanh lá = Camera) -->
                    <StackPanel x:Name="PrivacyIndicatorsPanel" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                        <!-- Microphone Indicator (Chấm Cam) -->
                        <Border x:Name="MicPrivacyDot" Width="7" Height="7" CornerRadius="3.5" Background="#FF9500" Margin="3,0,3,0" Cursor="Hand" ToolTipService.InitialShowDelay="50" MouseLeftButtonUp="MicPrivacyDot_MouseLeftButtonUp">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="0" Color="#FF9500" Opacity="0.9"/>
                            </Border.Effect>
                            <Border.ToolTip>
                                <ToolTip Background="#18181B" Foreground="#FFFFFF" BorderBrush="#38383D" Padding="8,6,8,6">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                            <TextBlock Text="&#xE720;" Style="{StaticResource FluentIconStyle}" FontSize="12" Foreground="#FF9500" Margin="0,0,5,0"/>
                                            <TextBlock Text="Microphone đang hoạt động" FontWeight="Bold" FontSize="11" Foreground="#FF9500"/>
                                        </StackPanel>
                                        <TextBlock x:Name="TxtMicTooltipApps" Text="Đang thu âm..." FontSize="10" Foreground="#E5E5EA"/>
                                        <TextBlock Text="💡 Click để Bật/Tắt Mic toàn hệ thống (Global Mic Mute)" FontSize="9" Foreground="#8E8E93" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </ToolTip>
                            </Border.ToolTip>
                        </Border>

                        <!-- Camera Indicator (Chấm Xanh Lá) -->
                        <Border x:Name="CameraPrivacyDot" Width="7" Height="7" CornerRadius="3.5" Background="#34C759" Margin="3,0,3,0" Cursor="Hand" ToolTipService.InitialShowDelay="50">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="0" Color="#34C759" Opacity="0.9"/>
                            </Border.Effect>
                            <Border.ToolTip>
                                <ToolTip Background="#18181B" Foreground="#FFFFFF" BorderBrush="#38383D" Padding="8,6,8,6">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                            <TextBlock Text="&#xE722;" Style="{StaticResource FluentIconStyle}" FontSize="12" Foreground="#34C759" Margin="0,0,5,0"/>
                                            <TextBlock Text="Webcam đang hoạt động" FontWeight="Bold" FontSize="11" Foreground="#34C759"/>
                                        </StackPanel>
                                        <TextBlock x:Name="TxtCamTooltipApps" Text="Đang mở camera..." FontSize="10" Foreground="#E5E5EA"/>
                                    </StackPanel>
                                </ToolTip>
                            </Border.ToolTip>
                        </Border>
                    </StackPanel>

                    <!-- Battery / Power -->
                    <StackPanel x:Name="BatteryPanel" Orientation="Horizontal" VerticalAlignment="Center" Grid.Column="2">
                        <TextBlock x:Name="TxtBatteryPercent" Text="98%" Foreground="#8E8E93" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <Border Width="16" Height="9" BorderBrush="#545458" BorderThickness="1" CornerRadius="2" VerticalAlignment="Center" Padding="1">
                            <Grid>
                                <Rectangle x:Name="BatteryFill" Fill="#34C759" HorizontalAlignment="Left" Width="10"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- 2. COMPACT MEDIA VIEW (Playing music) -->
                <Grid x:Name="CompactMediaView" Visibility="Collapsed" Margin="10,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Mini Album Art -->
                    <Border Grid.Column="0" Width="22" Height="22" CornerRadius="11" Background="#1E1E22" ClipToBounds="True" VerticalAlignment="Center">
                        <Image x:Name="ImgMiniThumb" Stretch="UniformToFill"/>
                    </Border>

                    <!-- Track Title Marquee/Trimming -->
                    <TextBlock x:Name="TxtMiniTitle" Grid.Column="1" Text="Song Title" Foreground="#FFFFFF" 
                               FontSize="12" FontWeight="Medium" TextTrimming="CharacterEllipsis" 
                               Margin="8,0,8,0" VerticalAlignment="Center" TextAlignment="Left"/>

                    <!-- Equalizer Waveform Animation (Màu xanh lá âm nhạc sống động) -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Height="14" Margin="2,0,4,0">
                        <!-- Privacy Indicators in Media View -->
                        <StackPanel x:Name="PrivacyIndicatorsPanelMedia" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0" Visibility="Collapsed">
                            <Border x:Name="MicPrivacyDotMedia" Width="6" Height="6" CornerRadius="3" Background="#FF9500" Margin="1,0,2,0" Cursor="Hand" ToolTipService.InitialShowDelay="50" MouseLeftButtonUp="MicPrivacyDot_MouseLeftButtonUp">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="5" ShadowDepth="0" Color="#FF9500" Opacity="0.9"/>
                                </Border.Effect>
                                <Border.ToolTip>
                                    <ToolTip Background="#18181B" Foreground="#FFFFFF" BorderBrush="#38383D" Padding="6,4,6,4">
                                        <TextBlock x:Name="TxtMicTooltipAppsMedia" Text="Microphone đang hoạt động (Click để Mute)" FontSize="10"/>
                                    </ToolTip>
                                </Border.ToolTip>
                            </Border>
                            <Border x:Name="CameraPrivacyDotMedia" Width="6" Height="6" CornerRadius="3" Background="#34C759" Margin="1,0,2,0" ToolTipService.InitialShowDelay="50">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="5" ShadowDepth="0" Color="#34C759" Opacity="0.9"/>
                                </Border.Effect>
                                <Border.ToolTip>
                                    <ToolTip Background="#18181B" Foreground="#FFFFFF" BorderBrush="#38383D" Padding="6,4,6,4">
                                        <TextBlock x:Name="TxtCamTooltipAppsMedia" Text="Webcam đang hoạt động" FontSize="10"/>
                                    </ToolTip>
                                </Border.ToolTip>
                            </Border>
                        </StackPanel>

                        <Rectangle x:Name="WaveBar1" Width="3" Height="8" Fill="#1DB954" RadiusX="1.5" RadiusY="1.5" Margin="1,0,1,0" VerticalAlignment="Bottom"/>
                        <Rectangle x:Name="WaveBar2" Width="3" Height="14" Fill="#1DB954" RadiusX="1.5" RadiusY="1.5" Margin="1,0,1,0" VerticalAlignment="Bottom"/>
                        <Rectangle x:Name="WaveBar3" Width="3" Height="10" Fill="#1DB954" RadiusX="1.5" RadiusY="1.5" Margin="1,0,1,0" VerticalAlignment="Bottom"/>
                    </StackPanel>
                </Grid>

                <!-- 3. EXPANDED CONTROL CENTER VIEW (Volume, Brightness & System Status) -->
                <Grid x:Name="ExpandedControlCenterView" Visibility="Collapsed" Margin="16,12,16,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Row 0: Top Header with Device/Status & Quick Actions -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Badge status & Battery -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#1C1C1E" BorderBrush="#2C2C2E" BorderThickness="1" CornerRadius="12" Padding="8,3,10,3" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE9E9;" Style="{StaticResource FluentIconStyle}" FontSize="11" Margin="0,0,0,0" Foreground="#FFFFFF"/>
                                    <!-- <TextBlock Text="Trung tâm điều khiển" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="11"/> -->
                                </StackPanel>
                            </Border>
                            
                            <!-- Battery Badge (Màu xanh lá đặc trưng cho pin) -->
                            <Border x:Name="ExpBatteryBadge" Background="#152A1C" BorderBrush="#245832" BorderThickness="1" CornerRadius="12" Padding="8,3,8,3">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtExpBatteryIcon" Text="&#xE860;" Style="{StaticResource FluentIconStyle}" FontSize="12" Margin="0,0,5,0" Foreground="#34C759"/>
                                    <TextBlock x:Name="TxtExpBatteryText" Text="100%" Foreground="#34C759" FontWeight="Bold" FontSize="11"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Right: Action Buttons -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Privacy Alert Badge in Control Center -->
                            <Border x:Name="ExpPrivacyBadge" Background="#261A08" BorderBrush="#5C3B0E" BorderThickness="1" CornerRadius="12" Padding="7,3,7,3" Margin="0,0,6,0" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse x:Name="ExpPrivacyDot" Width="6" Height="6" Fill="#FF9500" Margin="0,0,5,0"/>
                                    <TextBlock x:Name="TxtExpPrivacyText" Text="Mic đang dùng" Foreground="#FF9500" FontSize="10" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>

                            <!-- Global Mic Mute Toggle Button -->
                            <Button x:Name="BtnGlobalMicMute" Style="{StaticResource IslandButtonStyle}" Height="24" Padding="6,0,7,0" Click="BtnGlobalMicMute_Click" ToolTip="Tắt / Bật Micro toàn hệ thống" Margin="0,0,6,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtGlobalMicIcon" Text="&#xE720;" Style="{StaticResource FluentIconStyle}" FontSize="11" Margin="0,0,4,0" Foreground="#34C759"/>
                                    <TextBlock x:Name="TxtGlobalMicText" Text="Mic ON" FontSize="10" Foreground="#E5E5EA" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>

                            <!-- Music Player Switch Button (Màu xanh Spotify/Music đặc trưng) -->
                            <Button x:Name="BtnSwitchToMedia" Style="{StaticResource IslandButtonStyle}" Height="24" Padding="7,0,7,0" Click="BtnSwitchToMedia_Click" ToolTip="Mở trình phát nhạc" Margin="0,0,6,0" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#xEC4F;" Style="{StaticResource FluentIconStyle}" FontSize="11" Margin="0,0,5,0" Foreground="#1DB954"/>
                                    <TextBlock Text="Nhạc" FontSize="11" Foreground="#1DB954" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>

                            <!-- Settings Button -->
                            <Button Style="{StaticResource IslandButtonStyle}" Width="24" Height="24" Click="BtnSettings_Click" Margin="0,0,4,0" ToolTip="Cài đặt">
                                <TextBlock Text="&#xE713;" Style="{StaticResource FluentIconStyle}" FontSize="11" Foreground="#888898"/>
                            </Button>

                            <!-- Collapse Button -->
                            <Button Style="{StaticResource IslandButtonStyle}" Width="24" Height="24" Click="BtnCollapse_Click" ToolTip="Thu nhỏ">
                                <TextBlock Text="&#xE711;" Style="{StaticResource FluentIconStyle}" FontSize="10" Foreground="#888898"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Row 1: Volume Slider Card -->
                    <Border Grid.Row="1" Background="#161618" BorderBrush="#262628" BorderThickness="1" CornerRadius="12" Padding="12,6,12,6" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Mute / Unmute Button -->
                            <Button x:Name="BtnExpVolumeIcon" Grid.Column="0" Style="{StaticResource IslandButtonStyle}" Width="28" Height="28" Click="BtnExpVolumeIcon_Click" ToolTip="Bật / Tắt tiếng" VerticalAlignment="Center" Margin="0,0,8,0">
                                <TextBlock x:Name="TxtExpVolumeIcon" Text="&#xE994;" Style="{StaticResource FluentIconStyle}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>

                            <!-- Interactive Volume Slider -->
                            <Slider x:Name="SliderExpVolume" Grid.Column="1" Minimum="0" Maximum="100" Value="50" Foreground="#FFFFFF" Style="{StaticResource PillSliderStyle}" ValueChanged="SliderExpVolume_ValueChanged"/>

                            <!-- Percent Text -->
                            <TextBlock x:Name="TxtExpVolumePercent" Grid.Column="2" Text="50%" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12" Margin="10,0,2,0" VerticalAlignment="Center" Width="36" TextAlignment="Right"/>
                        </Grid>
                    </Border>

                    <!-- Row 2: Brightness Slider Card -->
                    <Border Grid.Row="2" Background="#161618" BorderBrush="#262628" BorderThickness="1" CornerRadius="12" Padding="12,6,12,6" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Sun Icon (Màu vàng ánh dương đặc trưng của độ sáng) -->
                            <Button Grid.Column="0" Style="{StaticResource IslandButtonStyle}" Width="28" Height="28" ToolTip="Độ sáng màn hình" VerticalAlignment="Center" Margin="0,0,8,0">
                                <TextBlock Text="&#xE706;" Style="{StaticResource FluentIconStyle}" FontSize="14" Foreground="#FFD54F" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>

                            <!-- Interactive Brightness Slider (Vàng hổ phách #FFD54F) -->
                            <Slider x:Name="SliderExpBrightness" Grid.Column="1" Minimum="0" Maximum="100" Value="70" Foreground="#FFD54F" Style="{StaticResource PillSliderStyle}" ValueChanged="SliderExpBrightness_ValueChanged"/>

                            <!-- Percent Text -->
                            <TextBlock x:Name="TxtExpBrightnessPercent" Grid.Column="2" Text="70%" Foreground="#FFD54F" FontWeight="Bold" FontSize="12" Margin="10,0,2,0" VerticalAlignment="Center" Width="36" TextAlignment="Right"/>
                        </Grid>
                    </Border>

                    <!-- Row 3: Bottom Quick Info Bar -->
                    <Grid Grid.Row="3" Margin="4,0,4,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE946;" Style="{StaticResource FluentIconStyle}" FontSize="11" Foreground="#71717A" Margin="0,0,5,0"/>
                            <TextBlock Text="Cuộn chuột trên viên thuốc để chỉnh nhanh • Giữ Alt để chỉnh độ sáng" Foreground="#71717A" FontSize="10" VerticalAlignment="Center"/>
                        </StackPanel>
                        
                        <TextBlock x:Name="TxtExpClock" Grid.Column="1" Text="15:30" Foreground="#8E8E93" FontSize="11" FontWeight="Medium" VerticalAlignment="Center"/>
                    </Grid>
                </Grid>

                <!-- 4. EXPANDED MEDIA VIEW (Detailed player) -->
                <Grid x:Name="ExpandedMediaView" Visibility="Collapsed" Margin="16,14,16,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Top Row: Cover Art + Info + Close/Collapse -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Album Art -->
                        <Border Grid.Column="0" Width="54" Height="54" CornerRadius="12" Background="#1E1E24" ClipToBounds="True">
                            <Image x:Name="ImgLargeThumb" Stretch="UniformToFill"/>
                        </Border>

                        <!-- Metadata -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,8,0">
                            <TextBlock x:Name="TxtLargeTitle" Text="Song Title" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="TxtLargeArtist" Text="Artist Name" Foreground="#A2A2AD" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                            <Border Background="#14291D" BorderBrush="#235034" BorderThickness="1" CornerRadius="4" Padding="6,1,6,1" HorizontalAlignment="Left" Margin="0,4,0,0">
                                <TextBlock x:Name="TxtAppSource" Text="Media" Foreground="#1DB954" FontSize="9" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>

                        <!-- Action buttons: Switch to Control Center + Settings + Collapse -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button Style="{StaticResource IslandButtonStyle}" Width="24" Height="24" Click="BtnSwitchToControlCenter_Click" Margin="0,0,4,0" ToolTip="Trung tâm điều khiển">
                                <TextBlock Text="&#xE9E9;" Style="{StaticResource FluentIconStyle}" FontSize="11" Foreground="#FFFFFF"/>
                            </Button>
                            <Button Style="{StaticResource IslandButtonStyle}" Width="24" Height="24" Click="BtnSettings_Click" Margin="0,0,4,0" ToolTip="Cài đặt">
                                <TextBlock Text="&#xE713;" Style="{StaticResource FluentIconStyle}" FontSize="11" Foreground="#888890"/>
                            </Button>
                            <Button Style="{StaticResource IslandButtonStyle}" Width="24" Height="24" Click="BtnCollapse_Click" ToolTip="Thu nhỏ">
                                <TextBlock Text="&#xE711;" Style="{StaticResource FluentIconStyle}" FontSize="10" Foreground="#888890"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Middle Row: Timeline Progress -->
                    <Grid Grid.Row="1" Margin="0,12,0,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Progress Bar (Xanh lá âm nhạc sống động) -->
                        <ProgressBar x:Name="MediaProgressBar" Height="4" Minimum="0" Maximum="100" Value="35" Foreground="#1DB954" Background="#262628" BorderThickness="0"/>

                        <!-- Timers -->
                        <Grid Grid.Row="1" Margin="0,3,0,0">
                            <TextBlock x:Name="TxtElapsed" Text="0:00" Foreground="#7D7D88" FontSize="10" HorizontalAlignment="Left"/>
                            <TextBlock x:Name="TxtDuration" Text="0:00" Foreground="#7D7D88" FontSize="10" HorizontalAlignment="Right"/>
                        </Grid>
                    </Grid>

                    <!-- Bottom Row: Controls -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Button Style="{StaticResource IslandButtonStyle}" Width="40" Height="36" Click="BtnPrev_Click">
                            <TextBlock Text="&#xE892;" Style="{StaticResource FluentIconStyle}" FontSize="13" Foreground="#E0E0E0"/>
                        </Button>
                        <Button Style="{StaticResource PlayButtonStyle}" Margin="18,0,18,0" Click="BtnPlayPause_Click">
                            <TextBlock x:Name="TxtPlayPauseIcon" Text="&#xE769;" Style="{StaticResource FluentIconStyle}" FontSize="14" Margin="0,0,0,0"/>
                        </Button>
                        <Button Style="{StaticResource IslandButtonStyle}" Width="40" Height="36" Click="BtnNext_Click">
                            <TextBlock Text="&#xE893;" Style="{StaticResource FluentIconStyle}" FontSize="13" Foreground="#E0E0E0"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- 4. FILE DROP VIEW (Hovering files over the island) -->
                <Grid x:Name="FileDropView" Visibility="Collapsed" Margin="14,0,14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- AirDrop Sky Blue (#0A84FF) đặc trưng của tính năng chia sẻ tệp -->
                    <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16" Background="#14243B" BorderBrush="#0A84FF" BorderThickness="1.5" VerticalAlignment="Center">
                        <TextBlock Text="&#xE72D;" Style="{StaticResource FluentIconStyle}" FontSize="14" Foreground="#0A84FF"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                        <TextBlock Text="Thả tệp để gửi đến điện thoại" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="12"/>
                        <TextBlock x:Name="TxtFileDropSubtitle" Text="Gửi không dây qua LocalSend" Foreground="#64B5F6" FontSize="10" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>

                <!-- 5. FILE TRANSFER VIEW (Sending files in progress) -->
                <Grid x:Name="FileTransferView" Visibility="Collapsed" Margin="10,0,10,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Top status row -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="&#xE898;" Style="{StaticResource FluentIconStyle}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#0A84FF"/>
                        <TextBlock x:Name="TxtTransferStatus" Grid.Column="1" Text="Đang gửi tệp..." Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtTransferPercent" Grid.Column="2" Text="0%" Foreground="#0A84FF" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Mini sleek progress bar -->
                    <ProgressBar x:Name="TransferProgressBar" Grid.Row="1" Height="4" Minimum="0" Maximum="100" Value="0" Foreground="#0A84FF" Background="#262628" BorderThickness="0" Margin="0,6,0,0"/>
                </Grid>

                <!-- 6. FILE RESULT VIEW (Success / Error notification) -->
                <Grid x:Name="FileResultView" Visibility="Collapsed" Margin="10,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="TxtResultIcon" Grid.Column="0" Text="&#xE73E;" Style="{StaticResource FluentIconStyle}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#34C759"/>
                    <TextBlock x:Name="TxtResultMessage" Grid.Column="1" Text="Đã gửi tệp thành công!" Foreground="#FFFFFF" FontWeight="Medium" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                </Grid>

                <!-- 7. SLIDER HUD VIEW (Volume & Brightness HUD) -->
                <Grid x:Name="SliderHudView" Visibility="Collapsed" Margin="12,0,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Icon (Bấm để Mute/Unmute âm lượng) -->
                    <Button x:Name="BtnHudIcon" Grid.Column="0" Style="{StaticResource IslandButtonStyle}" Width="28" Height="28" Click="BtnHudIcon_Click" ToolTip="Tắt / Bật tiếng" VerticalAlignment="Center" Margin="0,0,8,0">
                        <TextBlock x:Name="TxtHudIcon" Text="&#xE994;" Style="{StaticResource FluentIconStyle}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>

                    <!-- Smooth Slider Track (Bo tròn 4 góc chuẩn Apple Capsule) -->
                    <ProgressBar x:Name="HudProgressBar" Grid.Column="1" Height="10" Minimum="0" Maximum="100" Value="50" Style="{StaticResource RoundedProgressBarStyle}" VerticalAlignment="Center"/>

                    <!-- Value Percent -->
                    <TextBlock x:Name="TxtHudValue" Grid.Column="2" Text="50%" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12" Margin="10,0,2,0" VerticalAlignment="Center" Width="36" TextAlignment="Right"/>
                </Grid>

                <!-- 8. LOCK KEY & INPUT METHOD HUD VIEW -->
                <Grid x:Name="LockKeyHudView" Visibility="Collapsed" Margin="12,0,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Icon Badge -->
                    <Border Grid.Column="0" Width="26" Height="26" CornerRadius="13" Background="#1C1C1E" BorderBrush="#2C2C2E" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,8,0">
                        <TextBlock x:Name="TxtLockKeyIcon" Text="&#xE879;" Style="{StaticResource FluentIconStyle}" FontSize="12" Foreground="#FFFFFF"/>
                    </Border>

                    <!-- Info (Title & Subtitle) -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtLockKeyTitle" Text="Caps Lock" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="11" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="TxtLockKeySubtitle" Text="Viết hoa chữ cái" Foreground="#8E8E93" FontSize="9" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <!-- Status Pill Badge -->
                    <Border x:Name="LockKeyBadge" Grid.Column="2" Background="#152A1C" BorderBrush="#245832" BorderThickness="1" CornerRadius="10" Padding="8,2,8,2" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtLockKeyStatus" Text="BẬT" Foreground="#34C759" FontWeight="Bold" FontSize="10"/>
                    </Border>
                </Grid>
            </Grid>
        </Border>
        </Grid>
    </Grid>
</Window>
