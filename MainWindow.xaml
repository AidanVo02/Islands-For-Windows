<Window x:Class="DynamicIsland.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dynamic Island"
        Width="850" Height="380"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{x:Null}"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        AllowDrop="True"
        Loaded="Window_Loaded"
        Closed="Window_Closed"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <!-- Fluent Icon Font Style (Segoe Fluent Icons với fallback sang Segoe MDL2 Assets) -->
        <Style x:Key="FluentIconStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="IslandButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="15" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#44FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlayButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="20" Width="40" Height="40">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E2E2E2"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#B0B0B0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Rounded Pill ProgressBar Style (Bo tròn 4 góc chuẩn Apple) -->
        <Style x:Key="RoundedProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="10"/>
            <Setter Property="Background" Value="#28282C"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <!-- Background Track bo tròn 4 góc -->
                            <Border Background="{TemplateBinding Background}" CornerRadius="5"/>
                            
                            <!-- Indicator Track có bo tròn 4 góc -->
                            <Grid x:Name="PART_Track" ClipToBounds="True">
                                <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left" CornerRadius="5"/>
                            </Grid>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern iOS Pill Slider Style for Control Center -->
        <Style x:Key="PillSliderStyle" TargetType="Slider">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <!-- Background Track bo tròn 4 góc -->
                            <Border Height="14" Background="#28282C" CornerRadius="7" ClipToBounds="True"/>
                            
                            <!-- Track & Thumb -->
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Foreground="{TemplateBinding Foreground}" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="14" Background="{TemplateBinding Foreground}" CornerRadius="7"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="14" Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="24" Height="24" Cursor="Hand" Focusable="False">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid Width="24" Height="24" Background="Transparent">
                                                    <Ellipse Fill="#FFFFFF" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Ellipse.Effect>
                                                            <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.45" Color="#000000"/>
                                                        </Ellipse.Effect>
                                                    </Ellipse>
                                                </Grid>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Context Menu for Quick Control -->
    <Window.ContextMenu>
        <ContextMenu x:Name="IslandContextMenu" Background="#141416" Foreground="#EDEDED" BorderBrush="#2D2D33" Opened="IslandContextMenu_Opened" Closed="IslandContextMenu_Closed">
            <MenuItem Header="Cài đặt (Settings)" Click="MenuSettings_Click" FontWeight="SemiBold" InputGestureText="Ctrl+,">
                <MenuItem.Icon>
                    <TextBlock Style="{StaticResource FluentIconStyle}" Text="&#xE713;" FontSize="13" Foreground="#AEAEB2"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Tìm kiếm nhanh (Quick Search)" Click="MenuSearch_Click" InputGestureText="Alt+Space">
                <MenuItem.Icon>
                    <TextBlock Style="{StaticResource FluentIconStyle}" Text="&#xE721;" FontSize="13" Foreground="#AEAEB2"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem x:Name="MenuLockPosition" Header="Khóa vị trí (Lock Position)" IsCheckable="True" Click="MenuLockPosition_Click">
                <MenuItem.Icon>
                    <TextBlock Style="{StaticResource FluentIconStyle}" Text="&#xE72E;" FontSize="13" Foreground="#AEAEB2"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem x:Name="MenuAutoHide" Header="Tự động ẩn (Auto-Hide)" IsCheckable="True" Click="MenuAutoHide_Click">
                <MenuItem.Icon>
                    <TextBlock Style="{StaticResource FluentIconStyle}" Text="&#xE7B3;" FontSize="13" Foreground="#AEAEB2"/>
                </MenuItem.Icon>
            </MenuItem>
            <Separator Background="#2D2D33"/>
            <MenuItem x:Name="MenuMonitors" Header="Chọn Màn hình (Display)">
                <MenuItem.Icon>
                    <TextBlock Style="{StaticResource FluentIconStyle}" Text="&#xE7F4;" FontSize="13" Foreground="#AEAEB2"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Chuyển sang màn hình khác" Click="MenuSwitchNextMonitor_Click" InputGestureText="F9">
                <MenuItem.Icon>
                    <TextBlock Style="{StaticResource FluentIconStyle}" Text="&#xE895;" FontSize="13" Foreground="#AEAEB2"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Căn giữa màn hình hiện tại" Click="MenuResetPosition_Click">
                <MenuItem.Icon>
                    <TextBlock Style="{StaticResource FluentIconStyle}" Text="&#xE7C1;" FontSize="13" Foreground="#AEAEB2"/>
                </MenuItem.Icon>
            </MenuItem>
            <Separator Background="#2D2D33"/>
            <MenuItem Header="Bật / Thu nhỏ Expanded View" Click="MenuToggleExpand_Click">
                <MenuItem.Icon>
                    <TextBlock Style="{StaticResource FluentIconStyle}" Text="&#xE740;" FontSize="13" Foreground="#AEAEB2"/>
                </MenuItem.Icon>
            </MenuItem>
            <Separator Background="#2D2D33"/>
            <MenuItem Header="Thoát Dynamic Island" Click="MenuExit_Click">
                <MenuItem.Icon>
                    <TextBlock Style="{StaticResource FluentIconStyle}" Text="&#xE711;" FontSize="13" Foreground="#AEAEB2"/>
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </Window.ContextMenu>

    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <!-- Vùng cảm biến viền trên cùng màn hình khi Island đang ẩn -->
        <Border x:Name="TopEdgeTrigger"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Height="8"
                Width="340"
                Background="#01000000"
                MouseEnter="TopEdgeTrigger_MouseEnter"/>

        <!-- Khối chứa Island hỗ trợ hiệu ứng trượt ẩn/hiện -->
        <Grid x:Name="IslandRoot" HorizontalAlignment="Stretch" VerticalAlignment="Top">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="IslandTransform" Y="0"/>
            </Grid.RenderTransform>

            <!-- Lớp đổ bóng riêng biệt: Không chứa con nên bóng bo tròn 100% theo viên thuốc -->
            <Border x:Name="IslandShadow"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,2,0,0"
                Width="200"
                Height="36"
                CornerRadius="18"
                IsHitTestVisible="False"
                Background="#FF000000">
            <Border.Effect>
                <DropShadowEffect x:Name="IslandDropShadow" BlurRadius="22" ShadowDepth="0" Direction="270" Color="#000000" Opacity="0.55"/>
            </Border.Effect>
        </Border>

        <!-- Viên thuốc hiển thị nội dung -->
        <Border x:Name="IslandContainer"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,2,0,0"
                Width="200"
                Height="36"
                CornerRadius="18"
                Background="#080809"
                BorderBrush="#2A2A30"
                BorderThickness="1"
                ClipToBounds="True"
                Cursor="Hand"
                AllowDrop="True"
                PreviewDragEnter="IslandContainer_PreviewDragEnter"
                PreviewDragOver="IslandContainer_PreviewDragOver"
                PreviewDragLeave="IslandContainer_PreviewDragLeave"
                PreviewDrop="IslandContainer_PreviewDrop"
                MouseEnter="IslandContainer_MouseEnter"
                MouseLeave="IslandContainer_MouseLeave"
                PreviewMouseWheel="IslandContainer_PreviewMouseWheel"
                PreviewMouseLeftButtonDown="IslandContainer_PreviewMouseLeftButtonDown"
                PreviewMouseMove="IslandContainer_PreviewMouseMove"
                PreviewMouseLeftButtonUp="IslandContainer_PreviewMouseLeftButtonUp"
                IsManipulationEnabled="True"
                ManipulationStarting="IslandContainer_ManipulationStarting"
                ManipulationDelta="IslandContainer_ManipulationDelta">

            <Grid>
                <!-- 1. COMPACT IDLE VIEW -->
                <Grid x:Name="CompactIdleView" Visibility="Visible" Margin="16,0,16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Clock (Căn trái đều) -->
                    <StackPanel x:Name="ClockPanel" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Grid.Column="0">
                        <TextBlock x:Name="TxtClock" Text="12:00" Foreground="#F0F0F0" FontWeight="SemiBold" FontSize="13" FontFamily="Segoe UI Variable Display, Segoe UI" VerticalAlignment="Center" Margin="0,1.5,0,0" Typography.NumeralAlignment="Tabular" Typography.NumeralStyle="Lining"/>
                    </StackPanel>

                    <!-- Privacy Indicators (Đèn báo bảo mật nằm chuẩn 100% chính giữa viên thuốc) -->
                    <StackPanel x:Name="PrivacyIndicatorsPanel" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                        <!-- Microphone Indicator (Chấm Cam) -->
                        <Border x:Name="MicPrivacyDot" Width="7" Height="7" CornerRadius="3.5" Background="#FF9500" Margin="3,0,3,0" Cursor="Hand" ToolTipService.InitialShowDelay="50" MouseLeftButtonUp="MicPrivacyDot_MouseLeftButtonUp">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="0" Color="#FF9500" Opacity="0.9"/>
                            </Border.Effect>
                            <Border.ToolTip>
                                <ToolTip Background="#18181B" Foreground="#FFFFFF" BorderBrush="#38383D" Padding="8,6,8,6">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                            <TextBlock Text="&#xE720;" Style="{StaticResource FluentIconStyle}" FontSize="12" Foreground="#FF9500" Margin="0,0,5,0"/>
                                            <TextBlock Text="Microphone đang hoạt động" FontWeight="Bold" FontSize="11" Foreground="#FF9500"/>
                                        </StackPanel>
                                        <TextBlock x:Name="TxtMicTooltipApps" Text="Đang thu âm..." FontSize="10" Foreground="#E5E5EA"/>
                                        <TextBlock Text="💡 Click để Bật/Tắt Mic toàn hệ thống (Global Mic Mute)" FontSize="9" Foreground="#8E8E93" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </ToolTip>
                            </Border.ToolTip>
                        </Border>

                        <!-- Camera Indicator (Chấm Xanh Lá với hiệu ứng thở nhịp nhàng & Glow neon) -->
                        <Border x:Name="CameraPrivacyDot" Width="7" Height="7" CornerRadius="3.5" Background="#34C759" Margin="3,0,3,0" Cursor="Hand" ToolTipService.InitialShowDelay="50" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="IdleCameraDotScale" ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <Border.Effect>
                                <DropShadowEffect x:Name="IdleCameraDotGlow" BlurRadius="7" ShadowDepth="0" Color="#34C759" Opacity="0.95"/>
                            </Border.Effect>
                            <Border.ToolTip>
                                <ToolTip Background="#18181B" Foreground="#FFFFFF" BorderBrush="#38383D" Padding="8,6,8,6">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                            <TextBlock Text="&#xE722;" Style="{StaticResource FluentIconStyle}" FontSize="12" Foreground="#34C759" Margin="0,0,5,0"/>
                                            <TextBlock Text="Webcam đang hoạt động" FontWeight="Bold" FontSize="11" Foreground="#34C759"/>
                                        </StackPanel>
                                        <TextBlock x:Name="TxtCamTooltipApps" Text="Đang mở camera..." FontSize="10" Foreground="#E5E5EA"/>
                                    </StackPanel>
                                </ToolTip>
                            </Border.ToolTip>
                        </Border>
                    </StackPanel>

                    <!-- Battery / Power (Căn phải đều và cân bằng trục dọc) -->
                    <StackPanel x:Name="BatteryPanel" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Grid.Column="2">
                        <TextBlock x:Name="TxtBatteryPercent" Text="98%" Foreground="#8E8E93" FontSize="11" Margin="0,1.5,5,0" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" Typography.NumeralStyle="Lining"/>
                        <Border Width="16" Height="9" BorderBrush="#545458" BorderThickness="1" CornerRadius="2" VerticalAlignment="Center" Padding="1" Margin="0,1,0,0">
                            <Grid>
                                <Rectangle x:Name="BatteryFill" Fill="#34C759" HorizontalAlignment="Left" Width="10"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- 2. COMPACT MEDIA VIEW (Playing music) -->
                <Grid x:Name="CompactMediaView" Visibility="Collapsed" Margin="10,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Mini Album Art -->
                    <Border x:Name="BorderMiniThumb" Grid.Column="0" Width="22" Height="22" CornerRadius="11" Background="#1E1E22" ClipToBounds="True" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="MiniThumbScale" ScaleX="1.0" ScaleY="1.0"/>
                        </Border.RenderTransform>
                        <Image x:Name="ImgMiniThumb" Stretch="UniformToFill"/>
                    </Border>

                    <!-- Track Title Marquee/Trimming -->
                    <TextBlock x:Name="TxtMiniTitle" Grid.Column="1" Text="Song Title" Foreground="#FFFFFF" 
                               FontSize="12" FontWeight="Medium" TextTrimming="CharacterEllipsis" 
                               Margin="8,0,8,0" VerticalAlignment="Center" TextAlignment="Left"/>

                    <!-- Equalizer Waveform Animation (Màu xanh lá âm nhạc sống động) -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Height="14" Margin="2,0,4,0">
                        <!-- Privacy Indicators in Media View -->
                        <StackPanel x:Name="PrivacyIndicatorsPanelMedia" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0" Visibility="Collapsed">
                            <Border x:Name="MicPrivacyDotMedia" Width="6" Height="6" CornerRadius="3" Background="#FF9500" Margin="1,0,2,0" Cursor="Hand" ToolTipService.InitialShowDelay="50" MouseLeftButtonUp="MicPrivacyDot_MouseLeftButtonUp">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="5" ShadowDepth="0" Color="#FF9500" Opacity="0.9"/>
                                </Border.Effect>
                                <Border.ToolTip>
                                    <ToolTip Background="#18181B" Foreground="#FFFFFF" BorderBrush="#38383D" Padding="6,4,6,4">
                                        <TextBlock x:Name="TxtMicTooltipAppsMedia" Text="Microphone đang hoạt động (Click để Mute)" FontSize="10"/>
                                    </ToolTip>
                                </Border.ToolTip>
                            </Border>
                            <Border x:Name="CameraPrivacyDotMedia" Width="6" Height="6" CornerRadius="3" Background="#34C759" Margin="1,0,2,0" ToolTipService.InitialShowDelay="50">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="5" ShadowDepth="0" Color="#34C759" Opacity="0.9"/>
                                </Border.Effect>
                                <Border.ToolTip>
                                    <ToolTip Background="#18181B" Foreground="#FFFFFF" BorderBrush="#38383D" Padding="6,4,6,4">
                                        <TextBlock x:Name="TxtCamTooltipAppsMedia" Text="Webcam đang hoạt động" FontSize="10"/>
                                    </ToolTip>
                                </Border.ToolTip>
                            </Border>
                        </StackPanel>

                        <Rectangle x:Name="WaveBar1" Width="3" Height="3" Fill="#1DB954" RadiusX="1.5" RadiusY="1.5" Margin="1,0,1,0" VerticalAlignment="Bottom"/>
                        <Rectangle x:Name="WaveBar2" Width="3" Height="3" Fill="#1DB954" RadiusX="1.5" RadiusY="1.5" Margin="1,0,1,0" VerticalAlignment="Bottom"/>
                        <Rectangle x:Name="WaveBar3" Width="3" Height="3" Fill="#1DB954" RadiusX="1.5" RadiusY="1.5" Margin="1,0,1,0" VerticalAlignment="Bottom"/>
                        <Rectangle x:Name="WaveBar4" Width="3" Height="3" Fill="#1DB954" RadiusX="1.5" RadiusY="1.5" Margin="1,0,1,0" VerticalAlignment="Bottom"/>
                    </StackPanel>
                </Grid>

                <!-- 3. EXPANDED CONTROL CENTER VIEW (Volume, Brightness & System Status) -->
                <Grid x:Name="ExpandedControlCenterView" Visibility="Collapsed" Margin="16,12,16,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Row 0: Top Header with Device/Status, Center Clock & Quick Actions -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <!-- 1. Absolute Center Clock (Đồng hồ luôn nằm chuẩn 100% chính giữa Header, không bị đẩy lệch hay chèn ép) -->
                        <TextBlock x:Name="TxtExpClock" Text="12:00" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="20" 
                                   HorizontalAlignment="Center" VerticalAlignment="Center" 
                                   FontFamily="Segoe UI Variable Display, Segoe UI" IsHitTestVisible="False"
                                   Typography.NumeralAlignment="Tabular"
                                   Typography.NumeralStyle="Lining"
                                   Margin="0,1,0,0"/>

                        <!-- 2. DockPanel chứa 2 nhóm Left và Right trải đều 2 bên -->
                        <DockPanel LastChildFill="False" VerticalAlignment="Center">
                            <!-- Left: Badge status & Battery -->
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Circular Control Center Icon Badge (Tròn đều 26x26, icon ở chính giữa) -->
                                <Border Width="26" Height="26" CornerRadius="13" Background="#1C1C1E" BorderBrush="#2C2C2E" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <TextBlock Text="&#xE9E9;" Style="{StaticResource FluentIconStyle}" FontSize="12" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                
                                <!-- Battery Badge (Màu xanh lá đặc trưng cho pin) -->
                                <Border x:Name="ExpBatteryBadge" Height="26" CornerRadius="13" Background="#152A1C" BorderBrush="#245832" BorderThickness="1" Padding="8,0,8,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtExpBatteryIcon" Text="&#xE860;" Style="{StaticResource FluentIconStyle}" FontSize="12" Margin="0,0,5,0" Foreground="#34C759" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtExpBatteryText" Text="100%" Foreground="#34C759" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Right: Action Buttons (Căn phải thẳng hàng) -->
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <!-- Privacy Alert Badge in Control Center (Glow Neon & Breathing Pulse) -->
                                <Border x:Name="ExpPrivacyBadge" Height="26" CornerRadius="13" Background="#2434C759" BorderBrush="#34C759" BorderThickness="1" Padding="7,0,8,0" Margin="0,0,7,0" VerticalAlignment="Center" Visibility="Collapsed" Cursor="Hand" MouseLeftButtonUp="ExpPrivacyBadge_MouseLeftButtonUp">
                                    <!-- Aura Glow xung quanh background của badge -->
                                    <Border.Effect>
                                        <DropShadowEffect x:Name="ExpPrivacyGlow" Color="#34C759" BlurRadius="12" ShadowDepth="0" Opacity="0.55"/>
                                    </Border.Effect>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- Chấm xanh lá có ScaleTransform và Glow riêng để thở nhịp nhàng -->
                                        <Border Width="10" Height="10" Margin="0,0,5,0" VerticalAlignment="Center">
                                            <Ellipse x:Name="ExpPrivacyDot" Width="6" Height="6" Fill="#34C759" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                                <Ellipse.RenderTransform>
                                                    <ScaleTransform x:Name="ExpDotScale" ScaleX="1" ScaleY="1"/>
                                                </Ellipse.RenderTransform>
                                                <Ellipse.Effect>
                                                    <DropShadowEffect x:Name="ExpDotGlow" Color="#34C759" BlurRadius="8" ShadowDepth="0" Opacity="0.95"/>
                                                </Ellipse.Effect>
                                            </Ellipse>
                                        </Border>
                                        <TextBlock x:Name="TxtExpPrivacyIcon" Text="&#xE722;" Style="{StaticResource FluentIconStyle}" FontSize="11" Foreground="#34C759" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtExpPrivacyText" Text="Cam" Foreground="#34C759" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Border.ToolTip>
                                        <ToolTip Background="#18181B" Foreground="#FFFFFF" BorderBrush="#38383D" Padding="8,6,8,6">
                                            <TextBlock x:Name="TxtExpPrivacyTooltipDetail" Text="Webcam đang hoạt động" FontSize="11"/>
                                        </ToolTip>
                                    </Border.ToolTip>
                                </Border>

                                <!-- Global Mic Mute Toggle Button (Chỉ Icon 26x26 tròn đều, đổi icon và màu khi Mute) -->
                                <Button x:Name="BtnGlobalMicMute" Style="{StaticResource IslandButtonStyle}" Width="26" Height="26" Click="BtnGlobalMicMute_Click" ToolTip="Tắt / Bật Micro toàn hệ thống" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtGlobalMicIcon" Text="&#xE720;" Style="{StaticResource FluentIconStyle}" FontSize="12" Foreground="#34C759" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>

                                <!-- Settings Button -->
                                <Button Style="{StaticResource IslandButtonStyle}" Width="26" Height="26" Click="BtnSettings_Click" Margin="0,0,4,0" ToolTip="Cài đặt" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE713;" Style="{StaticResource FluentIconStyle}" FontSize="11" Foreground="#888898" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>

                                <!-- Collapse Button -->
                                <Button Style="{StaticResource IslandButtonStyle}" Width="26" Height="26" Click="BtnCollapse_Click" ToolTip="Thu nhỏ" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE711;" Style="{StaticResource FluentIconStyle}" FontSize="10" Foreground="#888898" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                            </StackPanel>
                        </DockPanel>
                    </Grid>

                    <!-- Row 1: Volume Slider Card (Cân xứng tuyệt đối 2 bên: 42px - * - 42px) -->
                    <Border x:Name="ExpandedCardVolume" Grid.Row="1" Background="#161618" BorderBrush="#262628" BorderThickness="1" CornerRadius="12" Padding="12,6,12,6" Margin="0,0,0,8" Cursor="Hand" PreviewMouseLeftButtonDown="ExpandedCardVolume_PreviewMouseLeftButtonDown">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="42"/>
                            </Grid.ColumnDefinitions>

                            <!-- Mute / Unmute Button -->
                            <Button x:Name="BtnExpVolumeIcon" Grid.Column="0" Style="{StaticResource IslandButtonStyle}" Width="28" Height="28" Click="BtnExpVolumeIcon_Click" ToolTip="Bật / Tắt tiếng" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtExpVolumeIcon" Text="&#xE994;" Style="{StaticResource FluentIconStyle}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>

                            <!-- Interactive Volume Slider (Nằm chính giữa card) -->
                            <Slider x:Name="SliderExpVolume" Grid.Column="1" Minimum="0" Maximum="100" Value="50" Foreground="#FFFFFF" Style="{StaticResource PillSliderStyle}" 
                                    VerticalAlignment="Center" Margin="4,0,4,0"
                                    ValueChanged="SliderExpVolume_ValueChanged"/>

                            <!-- Percent Text (Cân xứng với icon bên trái) -->
                            <TextBlock x:Name="TxtExpVolumePercent" Grid.Column="2" Text="50%" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" Width="40" TextAlignment="Right"/>
                        </Grid>
                    </Border>

                    <!-- Row 2: Brightness Slider Card (Cân xứng tuyệt đối 2 bên: 42px - * - 42px) -->
                    <Border x:Name="ExpandedCardBrightness" Grid.Row="2" Background="#161618" BorderBrush="#262628" BorderThickness="1" CornerRadius="12" Padding="12,6,12,6" Margin="0,0,0,8" Cursor="Hand" PreviewMouseLeftButtonDown="ExpandedCardBrightness_PreviewMouseLeftButtonDown">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="42"/>
                            </Grid.ColumnDefinitions>

                            <!-- Sun Icon (Màu vàng ánh dương đặc trưng của độ sáng) -->
                            <Button Grid.Column="0" Style="{StaticResource IslandButtonStyle}" Width="28" Height="28" ToolTip="Độ sáng màn hình" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock Text="&#xE706;" Style="{StaticResource FluentIconStyle}" FontSize="14" Foreground="#FFD54F" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>

                            <!-- Interactive Brightness Slider (Nằm chính giữa card) -->
                            <Slider x:Name="SliderExpBrightness" Grid.Column="1" Minimum="0" Maximum="100" Value="70" Foreground="#FFD54F" Style="{StaticResource PillSliderStyle}" 
                                    VerticalAlignment="Center" Margin="4,0,4,0"
                                    ValueChanged="SliderExpBrightness_ValueChanged"/>

                            <!-- Percent Text (Cân xứng với icon bên trái) -->
                            <TextBlock x:Name="TxtExpBrightnessPercent" Grid.Column="2" Text="70%" Foreground="#FFD54F" FontWeight="Bold" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" Width="40" TextAlignment="Right"/>
                        </Grid>
                    </Border>

                    <!-- Row 3: Bottom Switch Bar / Page Indicator (Căn chính giữa) -->
                    <Grid Grid.Row="3" Margin="4,2,4,0">
                        <!-- Clickable Switch Capsule: Tab 1 Active [●  ○] (Nhấn để chuyển sang Media Player) -->
                        <Border x:Name="ExpHintFooter" 
                                Height="18" 
                                Background="#18181B" 
                                BorderBrush="#2C2C30" 
                                BorderThickness="1" 
                                CornerRadius="9" 
                                Padding="12,0,12,0"
                                HorizontalAlignment="Center" 
                                VerticalAlignment="Center" 
                                Margin="0,2,0,0"
                                Cursor="Hand" 
                                ToolTip="Nhấn để chuyển sang Trình phát nhạc (hoặc Vuốt / Shift+Cuộn)" 
                                MouseLeftButtonUp="BtnSwitchToMedia_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="16" Height="4" CornerRadius="2" Background="#FFFFFF" Margin="2,0,2,0"/>
                                <Border Width="5" Height="4" CornerRadius="2" Background="#545458" Margin="2,0,2,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Privacy Alert Footer (Hiển thị chi tiết app dùng Camera / Mic khi phát hiện) -->
                        <StackPanel x:Name="ExpPrivacyFooter" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                            <TextBlock x:Name="TxtExpPrivacyFooterIcon" Text="&#xE722;" Style="{StaticResource FluentIconStyle}" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtExpPrivacyFooterText" Text="" Foreground="#8E8E93" FontSize="10" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- 4. EXPANDED MEDIA VIEW (Detailed player with Live Lyrics) -->
                <Grid x:Name="ExpandedMediaView" Visibility="Collapsed" Margin="22,12,22,10">
                    <Grid.RowDefinitions>
                        <!-- Row 0: Hai cột chính (Lyrics bên trái, Thông tin & Controls bên phải) -->
                        <RowDefinition Height="*"/>
                        <!-- Row 1: Thanh chuyển trang nằm tách biệt ở đáy, căn chính giữa, không phạm nút Play -->
                        <RowDefinition Height="22"/>
                    </Grid.RowDefinitions>

                    <!-- Main Two-Column Layout -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <!-- Cột Trái: LIVE LYRICS (~58%) -->
                            <ColumnDefinition Width="58*"/>
                            <!-- Đường kẻ dọc phân cách thanh lịch -->
                            <ColumnDefinition Width="1"/>
                            <!-- Cột Phải: THÔNG TIN BÀI HÁT & CONTROLS (~42%) -->
                            <ColumnDefinition Width="42*"/>
                        </Grid.ColumnDefinitions>

                        <!-- LEFT: LIVE LYRICS SECTION -->
                        <Grid Grid.Column="0" Margin="0,0,16,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Lyrics Section Header -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,6">
                                <TextBlock Text="&#xEC4F;" Style="{StaticResource FluentIconStyle}" FontSize="13" Foreground="#1DB954" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="LỜI BÀI HÁT TRỰC TIẾP" FontSize="10" FontWeight="Bold" Foreground="#1DB954" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtLyricsStatus" Text="" FontSize="10" Foreground="#8E8E98" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Live Lyrics Content Container (Căn chính giữa theo chiều dọc) -->
                            <Grid Grid.Row="1" x:Name="LyricsContainer" ClipToBounds="True" Height="160" VerticalAlignment="Center" SizeChanged="LyricsContainer_SizeChanged" PreviewMouseWheel="LyricsContainer_PreviewMouseWheel">
                                <!-- 1. Canvas giải phóng giới hạn chiều cao layout để toàn bộ lời bài hát được render đầy đủ -->
                                <Canvas x:Name="LyricsCanvas" ClipToBounds="True">
                                    <StackPanel x:Name="LyricsScrollPanel" Width="{Binding ActualWidth, ElementName=LyricsContainer}">
                                        <StackPanel.RenderTransform>
                                            <TranslateTransform x:Name="LyricsTranslate" Y="0"/>
                                        </StackPanel.RenderTransform>
                                    </StackPanel>
                                </Canvas>

                                <!-- 2. Panel khi KHÔNG CÓ lời bài hát / Đang tải -->
                                <StackPanel x:Name="PanelLyricsEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                                    <TextBlock x:Name="TxtLyricsEmptyIcon" Text="&#xEC4F;" Style="{StaticResource FluentIconStyle}" FontSize="24" Foreground="#3A3A42" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                    <TextBlock x:Name="TxtLyricsEmptyMessage" Text="Không có lời bài hát đồng bộ" FontSize="12" Foreground="#7D7D88" HorizontalAlignment="Center"/>
                                </StackPanel>

                                <!-- 3. Lớp phủ mờ đỉnh và đáy chuẩn Apple Music / Spotify (100% tương thích Transparent Window) -->
                                <Border x:Name="LyricsTopFadeBorder" Height="24" VerticalAlignment="Top" IsHitTestVisible="False">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Offset="0.0" Color="#FF080809"/>
                                            <GradientStop Offset="1.0" Color="#00080809"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>

                                <Border x:Name="LyricsBottomFadeBorder" Height="28" VerticalAlignment="Bottom" IsHitTestVisible="False">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Offset="0.0" Color="#00080809"/>
                                            <GradientStop Offset="1.0" Color="#FF080809"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                            </Grid>
                        </Grid>

                        <!-- VERTICAL DIVIDER -->
                        <Rectangle Grid.Column="1" Width="1" Fill="#24242C" VerticalAlignment="Stretch" Margin="0,2,0,2"/>

                        <!-- RIGHT: SONG INFO & CONTROLS SECTION -->
                        <Grid Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Row 0: Art + Metadata + Actions -->
                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Album Art (52x52) -->
                                <Border Grid.Column="0" Width="52" Height="52" CornerRadius="10" Background="#1E1E24" ClipToBounds="True" VerticalAlignment="Center">
                                    <Image x:Name="ImgLargeThumb" Stretch="UniformToFill"/>
                                </Border>

                                <!-- Metadata -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,6,0">
                                    <TextBlock x:Name="TxtLargeTitle" Text="Song Title" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="TxtLargeArtist" Text="Artist Name" Foreground="#9E9EA8" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                    <Border Background="#14291D" BorderBrush="#235034" BorderThickness="1" CornerRadius="4" Padding="5,1.5,5,1.5" HorizontalAlignment="Left" Margin="0,3,0,0">
                                        <TextBlock x:Name="TxtAppSource" Text="Media" Foreground="#1DB954" FontSize="9" FontWeight="SemiBold"/>
                                    </Border>
                                </StackPanel>

                                <!-- Actions: Settings + Collapse -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                                    <Button Style="{StaticResource IslandButtonStyle}" Width="24" Height="24" Click="BtnSettings_Click" Margin="0,0,3,0" ToolTip="Cài đặt">
                                        <TextBlock Text="&#xE713;" Style="{StaticResource FluentIconStyle}" FontSize="11" Foreground="#888894"/>
                                    </Button>
                                    <Button Style="{StaticResource IslandButtonStyle}" Width="24" Height="24" Click="BtnCollapse_Click" ToolTip="Thu nhỏ">
                                        <TextBlock Text="&#xE711;" Style="{StaticResource FluentIconStyle}" FontSize="10" Foreground="#888894"/>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- Row 1: Timeline Progress Bar + Timers -->
                            <Grid Grid.Row="1" Margin="0,0,0,10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <ProgressBar x:Name="MediaProgressBar" Height="4" Minimum="0" Maximum="100" Value="35" Foreground="#1DB954" Background="#262628" BorderThickness="0"/>

                                <Grid Grid.Row="1" Margin="0,3,0,0">
                                    <TextBlock x:Name="TxtElapsed" Text="0:00" Foreground="#8E8E98" FontSize="10" HorizontalAlignment="Left"/>
                                    <TextBlock x:Name="TxtDuration" Text="0:00" Foreground="#8E8E98" FontSize="10" HorizontalAlignment="Right"/>
                                </Grid>
                            </Grid>

                            <!-- Row 2: Controls (Prev, Play, Next) -->
                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Button Style="{StaticResource IslandButtonStyle}" Width="36" Height="34" Click="BtnPrev_Click">
                                    <TextBlock Text="&#xE892;" Style="{StaticResource FluentIconStyle}" FontSize="13" Foreground="#E0E0E0"/>
                                </Button>
                                <Button Style="{StaticResource PlayButtonStyle}" Margin="14,0,14,0" Click="BtnPlayPause_Click">
                                    <TextBlock x:Name="TxtPlayPauseIcon" Text="&#xE769;" Style="{StaticResource FluentIconStyle}" FontSize="13" Margin="0,0,0,0"/>
                                </Button>
                                <Button Style="{StaticResource IslandButtonStyle}" Width="36" Height="34" Click="BtnNext_Click">
                                    <TextBlock Text="&#xE893;" Style="{StaticResource FluentIconStyle}" FontSize="13" Foreground="#E0E0E0"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- Row 1: Bottom Switch Bar (Nằm gọn ở đáy, căn chính giữa, tách biệt tuyệt đối) -->
                    <Grid Grid.Row="1" VerticalAlignment="Center">
                        <Border Height="16" 
                                Background="#18181B" 
                                BorderBrush="#2C2C30" 
                                BorderThickness="1" 
                                CornerRadius="8" 
                                Padding="12,0,12,0" 
                                HorizontalAlignment="Center" 
                                VerticalAlignment="Center" 
                                Cursor="Hand" 
                                ToolTip="Nhấn để chuyển sang Trung tâm điều khiển (hoặc Vuốt / Shift+Cuộn)" 
                                MouseLeftButtonUp="BtnSwitchToControlCenter_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="5" Height="4" CornerRadius="2" Background="#545458" Margin="2,0,2,0"/>
                                <Border Width="16" Height="4" CornerRadius="2" Background="#1DB954" Margin="2,0,2,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <!-- 4. FILE DROP VIEW (Hovering files over the island) -->
                <Grid x:Name="FileDropView" Visibility="Collapsed" Margin="14,0,14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- AirDrop Sky Blue (#0A84FF) đặc trưng của tính năng chia sẻ tệp -->
                    <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16" Background="#14243B" BorderBrush="#0A84FF" BorderThickness="1.5" VerticalAlignment="Center">
                        <TextBlock Text="&#xE72D;" Style="{StaticResource FluentIconStyle}" FontSize="14" Foreground="#0A84FF"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                        <TextBlock Text="Thả tệp để gửi đến điện thoại" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="12"/>
                        <TextBlock x:Name="TxtFileDropSubtitle" Text="Gửi không dây qua LocalSend" Foreground="#64B5F6" FontSize="10" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>

                <!-- 5. FILE TRANSFER VIEW (Sending files in progress) -->
                <Grid x:Name="FileTransferView" Visibility="Collapsed" Margin="10,0,10,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Top status row -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="&#xE898;" Style="{StaticResource FluentIconStyle}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#0A84FF"/>
                        <TextBlock x:Name="TxtTransferStatus" Grid.Column="1" Text="Đang gửi tệp..." Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtTransferPercent" Grid.Column="2" Text="0%" Foreground="#0A84FF" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Mini sleek progress bar -->
                    <ProgressBar x:Name="TransferProgressBar" Grid.Row="1" Height="4" Minimum="0" Maximum="100" Value="0" Foreground="#0A84FF" Background="#262628" BorderThickness="0" Margin="0,6,0,0"/>
                </Grid>

                <!-- 6. FILE RESULT VIEW (Success / Error notification) -->
                <StackPanel x:Name="FileResultView" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock x:Name="TxtResultIcon" Text="&#xE73E;" Style="{StaticResource FluentIconStyle}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#34C759"/>
                    <TextBlock x:Name="TxtResultMessage" Text="Đã gửi tệp thành công!" Foreground="#FFFFFF" FontWeight="Medium" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 7. SLIDER HUD VIEW (Volume & Brightness HUD cân xứng hoàn hảo) -->
                <Grid x:Name="SliderHudView" Visibility="Collapsed" Margin="12,0,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="38"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="38"/>
                    </Grid.ColumnDefinitions>

                    <!-- Icon (Bấm để Mute/Unmute âm lượng) -->
                    <Button x:Name="BtnHudIcon" Grid.Column="0" Style="{StaticResource IslandButtonStyle}" Width="26" Height="26" Click="BtnHudIcon_Click" ToolTip="Tắt / Bật tiếng" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtHudIcon" Text="&#xE994;" Style="{StaticResource FluentIconStyle}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>

                    <!-- Smooth Slider Track (Bo tròn 4 góc chuẩn Apple Capsule, nằm chính giữa HUD) -->
                    <ProgressBar x:Name="HudProgressBar" Grid.Column="1" Height="10" Minimum="0" Maximum="100" Value="50" Style="{StaticResource RoundedProgressBarStyle}" VerticalAlignment="Center" Margin="4,0,4,0" Cursor="Hand" PreviewMouseLeftButtonDown="HudProgressBar_PreviewMouseLeftButtonDown" PreviewMouseMove="HudProgressBar_PreviewMouseMove" PreviewMouseLeftButtonUp="HudProgressBar_PreviewMouseLeftButtonUp"/>

                    <!-- Value Percent (Cân đối hoàn hảo với Icon bên trái) -->
                    <TextBlock x:Name="TxtHudValue" Grid.Column="2" Text="50%" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" Width="36" TextAlignment="Right"/>
                </Grid>

                <!-- 8. LOCK KEY & INPUT METHOD HUD VIEW -->
                <Grid x:Name="LockKeyHudView" Visibility="Collapsed" Margin="12,0,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Icon Badge -->
                    <Border Grid.Column="0" Width="26" Height="26" CornerRadius="13" Background="#1C1C1E" BorderBrush="#2C2C2E" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,8,0">
                        <TextBlock x:Name="TxtLockKeyIcon" Text="&#xE879;" Style="{StaticResource FluentIconStyle}" FontSize="12" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Info (Title & Subtitle) -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtLockKeyTitle" Text="Caps Lock" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="11" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="TxtLockKeySubtitle" Text="Viết hoa chữ cái" Foreground="#8E8E93" FontSize="9" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <!-- Status Pill Badge -->
                    <Border x:Name="LockKeyBadge" Grid.Column="2" Height="22" Background="#152A1C" BorderBrush="#245832" BorderThickness="1" CornerRadius="11" Padding="8,0,8,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtLockKeyStatus" Text="BẬT" Foreground="#34C759" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
                <!-- 9. QUICK SEARCH & APP LAUNCHER VIEW -->
                <Grid x:Name="SearchView" Visibility="Collapsed" VerticalAlignment="Top">
                    <Grid.RowDefinitions>
                        <!-- Row 0: Search Input Bar (Cố định 48px) -->
                        <RowDefinition Height="48"/>
                        <!-- Row 1: Subtle Horizontal Divider -->
                        <RowDefinition Height="Auto"/>
                        <!-- Row 2: Search Results List (Co giãn tự động tối đa 5 dòng) -->
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Top Input Bar (48px) -->
                    <Grid Grid.Row="0" Margin="16,0,16,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Search Icon (Trái) -->
                        <TextBlock Grid.Column="0" Text="&#xE721;" Style="{StaticResource FluentIconStyle}" FontSize="15" Foreground="#8E8E93" VerticalAlignment="Center" Margin="0,0,10,0"/>

                        <!-- Search TextBox & Placeholder (Giữa) -->
                        <Grid Grid.Column="1" VerticalAlignment="Center">
                            <!-- Placeholder mờ khi chưa gõ chữ -->
                            <TextBlock x:Name="TxtSearchPlaceholder" 
                                       Text="Tìm ứng dụng, tính toán hoặc gõ lệnh..." 
                                       Foreground="#636366" 
                                       FontSize="14" 
                                       FontFamily="Segoe UI Variable Display, Segoe UI" 
                                       VerticalAlignment="Center" 
                                       IsHitTestVisible="False"
                                       Visibility="Visible"/>

                            <TextBox x:Name="SearchTextBox" 
                                     Background="Transparent" 
                                     BorderThickness="0" 
                                     Foreground="#FFFFFF" 
                                     CaretBrush="#FFFFFF" 
                                     FontSize="14" 
                                     FontFamily="Segoe UI Variable Display, Segoe UI" 
                                     VerticalAlignment="Center"
                                     VerticalContentAlignment="Center"
                                     Padding="0"
                                     FocusVisualStyle="{x:Null}"
                                     TextChanged="SearchTextBox_TextChanged"
                                     PreviewKeyDown="SearchTextBox_PreviewKeyDown"/>
                        </Grid>

                        <!-- Badge phím tắt ESC (Phải) -->
                        <Border Grid.Column="2" 
                                Background="#1C1C1E" 
                                BorderBrush="#38383A" 
                                BorderThickness="1" 
                                CornerRadius="6" 
                                Padding="6,2,6,2" 
                                VerticalAlignment="Center" 
                                Cursor="Hand"
                                ToolTip="Bấm ESC để đóng tìm kiếm"
                                MouseLeftButtonUp="BtnCloseSearch_MouseLeftButtonUp">
                            <TextBlock Text="ESC" FontSize="10" FontWeight="SemiBold" Foreground="#8E8E93" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                    </Grid>

                    <!-- Row 1: Subtle Horizontal Divider Line -->
                    <Border x:Name="SearchDivider" 
                            Grid.Row="1" 
                            Height="1" 
                            Background="#14FFFFFF" 
                            Margin="16,0,16,6" 
                            Visibility="Collapsed"/>

                    <!-- Row 2: Results List -->
                    <ListBox x:Name="SearchListBox" 
                             Grid.Row="2" 
                             Background="Transparent" 
                             BorderThickness="0" 
                             Padding="0" 
                             Margin="12,2,12,14"
                             Visibility="Collapsed"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             PreviewMouseLeftButtonUp="SearchListBox_PreviewMouseLeftButtonUp">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Focusable" Value="False"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Padding" Value="10,6,10,6"/>
                                <Setter Property="Margin" Value="0,1,0,1"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#22FFFFFF"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#14FFFFFF"/>
                                                </Trigger>
                                                <MultiTrigger>
                                                    <MultiTrigger.Conditions>
                                                        <Condition Property="IsSelected" Value="True"/>
                                                        <Condition Property="IsMouseOver" Value="True"/>
                                                    </MultiTrigger.Conditions>
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#2AFFFFFF"/>
                                                </MultiTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="34" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Icon Column: Hoặc Image thật (App), hoặc Fluent Glyph (Calculator/Web/Sys) -->
                                    <Grid Grid.Column="0" Width="28" Height="28" VerticalAlignment="Center" HorizontalAlignment="Left">
                                        <!-- App Icon -->
                                        <Image Source="{Binding Icon}" Width="28" Height="28" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>

                                        <!-- Fluent Glyph Icon Container (khi không có Icon ảnh) -->
                                        <Border CornerRadius="7" Background="#1C1C20" Width="28" Height="28">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding IconGlyph}" 
                                                       Style="{StaticResource FluentIconStyle}" 
                                                       FontSize="13" 
                                                       Foreground="{Binding IconGlyphBrush}" 
                                                       HorizontalAlignment="Center" 
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                    </Grid>

                                    <!-- Info Column (Title + Subtitle) -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,8,0">
                                        <TextBlock Text="{Binding Title}" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Subtitle}" Foreground="#99FFFFFF" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                                    </StackPanel>

                                    <!-- Right Hint Badge -->
                                    <Border Grid.Column="2" 
                                            Background="#14FFFFFF" 
                                            BorderBrush="#18FFFFFF" 
                                            BorderThickness="1" 
                                            CornerRadius="5" 
                                            Padding="6,2.5,6,2.5" 
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ActionHint}" Foreground="#AEAEB2" FontSize="9.5" FontWeight="Medium"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Grid>
        </Border>
        </Grid>
    </Grid>
</Window>
