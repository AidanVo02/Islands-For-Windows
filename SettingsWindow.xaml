                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Tại sao LocalSend không gửi được ở quán cà phê?" Foreground="#70A0FF" FontWeight="SemiBold" FontSize="12"/>
                                        <TextBlock Text="Các mạng Wi-Fi công cộng luôn bật tính năng 'AP Isolation' (cô lập thiết bị) để bảo mật, ngăn các máy trong quán thấy nhau. Vì vậy, Phương án 1 (Phone Link) là giải pháp hoàn hảo vì kết nối qua Bluetooth và dịch vụ Microsoft! Nếu dùng LocalSend bị lỗi, Dynamic Island cũng sẽ tự động chuyển sang Phone Link cho bạn." Foreground="#9AB5E0" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Card 1: Tự động dò tìm điện thoại -->
                            <Border Style="{StaticResource SettingCardBorder}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Tự động dò tìm điện thoại (Khuyến nghị)" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock Text="Tự động quét và tìm kiếm điện thoại đang mở LocalSend trong cùng mạng Wi-Fi." Foreground="#808092" FontSize="11" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <CheckBox x:Name="ChkLocalSendAutoDiscovery" Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" IsChecked="True" Click="ChkLocalSendAutoDiscovery_Click"/>
                                </Grid>
                            </Border>

                            <!-- Card 2: Cấu hình địa chỉ IP mục tiêu -->
                            <Border Style="{StaticResource SettingCardBorder}">
                                <StackPanel>
                                    <TextBlock Text="Cấu hình thiết bị nhận" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,4"/>
                                    <TextBlock Text="Nếu máy không tự động tìm thấy, bạn có thể nhập trực tiếp địa chỉ IP hiển thị trong app LocalSend trên điện thoại." Foreground="#808092" FontSize="11" Margin="0,0,0,14"/>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="100"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Địa chỉ IP điện thoại" Foreground="#B0B0C0" FontSize="11" Margin="0,0,0,6"/>
                                            <TextBox x:Name="TxtLocalSendIp" Height="32" TextChanged="TxtLocalSendIp_TextChanged"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Cổng (Port)" Foreground="#B0B0C0" FontSize="11" Margin="0,0,0,6"/>
                                            <TextBox x:Name="TxtLocalSendPort" Height="32" Text="53317" TextChanged="TxtLocalSendPort_TextChanged"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Action buttons & status -->
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Button x:Name="BtnLocalSendScan" Grid.Column="0" Style="{StaticResource ModernButtonStyle}" Click="BtnLocalSendScan_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="🔍" FontSize="11" Margin="0,0,6,0"/>
                                                <TextBlock Text="Quét tìm điện thoại"/>
                                            </StackPanel>
                                        </Button>

                                        <Button x:Name="BtnLocalSendTest" Grid.Column="2" Style="{StaticResource ModernButtonStyle}" Click="BtnLocalSendTest_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="⚡" FontSize="11" Margin="0,0,6,0"/>
                                                <TextBlock Text="Thử kết nối"/>
                                            </StackPanel>
                                        </Button>

                                        <TextBlock x:Name="TxtLocalSendStatus" Grid.Column="3" Text="Sẵn sàng quét" Foreground="#858595" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Card 3: Hướng dẫn nhanh -->
                            <Border Style="{StaticResource SettingCardBorder}">
                                <StackPanel>
                                    <TextBlock Text="📖 Cách sử dụng cực kỳ đơn giản" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,10"/>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="20" Height="20" CornerRadius="10" Background="#242432" Margin="0,0,10,0">
                                            <TextBlock Text="1" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="Cài đặt LocalSend trên điện thoại (Android qua CH Play, iOS qua App Store - Miễn phí 100%)." Foreground="#B0B0C0" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="20" Height="20" CornerRadius="10" Background="#242432" Margin="0,0,10,0">
                                            <TextBlock Text="2" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="Đảm bảo máy tính và điện thoại đang bắt chung 1 mạng Wi-Fi gia đình / văn phòng." Foreground="#B0B0C0" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="20" Height="20" CornerRadius="10" Background="#242432" Margin="0,0,10,0">
                                            <TextBlock Text="3" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="Mở LocalSend trên điện thoại, sau đó kéo tệp bất kỳ từ máy tính thả vào viên thuốc Dynamic Island!" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Window>
