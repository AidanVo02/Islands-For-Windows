<Window x:Class="DynamicIsland.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dynamic Island - Cài đặt"
        Width="840" Height="600"
        MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        Loaded="Window_Loaded">

    <Window.Resources>
        <!-- Toggle Switch CheckBox Style -->
        <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Border x:Name="SwitchTrack" Width="46" Height="26" CornerRadius="13" Background="#2B2B36" BorderBrush="#3A3A48" BorderThickness="1">
                                <Border.Triggers>
                                    <!-- Transitions -->
                                </Border.Triggers>
                                <Ellipse x:Name="SwitchThumb" Width="18" Height="18" Fill="#FFFFFF" HorizontalAlignment="Left" Margin="4,0,0,0">
                                    <Ellipse.Effect>
                                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.3"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchTrack" Property="Background" Value="#545458"/>
                                <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="#636366"/>
                                <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="SwitchThumb" Property="Margin" Value="0,0,4,0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SwitchTrack" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar Tab Button Style -->
        <Style x:Key="NavTabButtonStyle" TargetType="RadioButton">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="0,3,0,3"/>
            <Setter Property="Foreground" Value="#A0A0B0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="Transparent" CornerRadius="8" Padding="12,0,12,0">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1A1A24"/>
                                <Setter Property="Foreground" Value="#E2E2E8"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#252535"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Action Button Style -->
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#252532"/>
            <Setter Property="Foreground" Value="#F0F0F5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#383848"/>
            <Setter Property="Padding" Value="14,8,14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#323242"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#4B4B60"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#20202A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Neutral Button -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E5E5EA"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#D1D1D6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Slider Style -->
        <Style x:Key="ModernSliderStyle" TargetType="Slider">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Card Container Style -->
        <Style x:Key="SettingCardBorder" TargetType="Border">
            <Setter Property="Background" Value="#17171F"/>
            <Setter Property="BorderBrush" Value="#262634"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16,14,16,14"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <!-- Dark ComboBox Styling -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#252535"/>
            <Setter Property="Foreground" Value="#F0F0F5"/>
            <Setter Property="BorderBrush" Value="#383848"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4,8,4"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#181822"/>
            <Setter Property="Foreground" Value="#EDEDF5"/>
            <Setter Property="Padding" Value="8,6,8,6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Modern Dark TextBox Styling -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1C1C26"/>
            <Setter Property="Foreground" Value="#F0F0F8"/>
            <Setter Property="CaretBrush" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#323244"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5,8,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#8E8E93"/>
                                <Setter TargetName="border" Property="Background" Value="#222226"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Main Container Window with Outer Glow/Shadow -->
    <Border Margin="12" CornerRadius="16" Background="#111116" BorderBrush="#252532" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" ShadowDepth="6" Direction="270" Color="#000000" Opacity="0.7"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Custom Modern Titlebar -->
            <Grid Grid.Row="0" Background="#16161D" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- App Icon & Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Border Width="26" Height="26" CornerRadius="13" Background="#000000" BorderBrush="#3A3A3C" BorderThickness="1.5" Margin="0,0,10,0">
                        <Border Width="10" Height="10" CornerRadius="5" Background="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Dynamic Island" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                    <Border Background="#252528" CornerRadius="4" Padding="6,2,6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Cài đặt hệ thống" Foreground="#AEAEB2" FontSize="11" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>

                <!-- Minimize & Close Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                    <Button Width="34" Height="30" Background="Transparent" BorderThickness="0" Foreground="#A0A0B0" Cursor="Hand" Click="BtnMinimize_Click">
                        <TextBlock Text="—" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button Width="34" Height="30" Background="Transparent" BorderThickness="0" Foreground="#A0A0B0" Cursor="Hand" Click="BtnClose_Click">
                        <TextBlock Text="✕" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Body Area -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Sidebar Navigation -->
                <Border Grid.Column="0" Background="#13131A" BorderBrush="#20202C" BorderThickness="0,0,1,0" Padding="14,16,14,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Nav List -->
                        <StackPanel Grid.Row="0">
                            <TextBlock Text="DANH MỤC" Foreground="#6A6A7D" FontSize="10" FontWeight="Bold" Margin="8,0,0,10"/>

                            <RadioButton x:Name="NavDisplay" Style="{StaticResource NavTabButtonStyle}" IsChecked="True" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🖥️" FontSize="13" Margin="0,0,10,0"/>
                                    <TextBlock Text="Màn hình &amp; Vị trí"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="NavAppearance" Style="{StaticResource NavTabButtonStyle}" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🎨" FontSize="13" Margin="0,0,10,0"/>
                                    <TextBlock Text="Giao diện &amp; Kích thước"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="NavFeatures" Style="{StaticResource NavTabButtonStyle}" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚡" FontSize="13" Margin="0,0,10,0"/>
                                    <TextBlock Text="Tính năng &amp; Widget"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="NavLocalSend" Style="{StaticResource NavTabButtonStyle}" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📲" FontSize="13" Margin="0,0,10,0"/>
                                    <TextBlock Text="Truyền file sang ĐT"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="NavSystem" Style="{StaticResource NavTabButtonStyle}" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚙️" FontSize="13" Margin="0,0,10,0"/>
                                    <TextBlock Text="Hệ thống &amp; Phím tắt"/>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>

                        <!-- Bottom Buttons -->
                        <StackPanel Grid.Row="1">
                            <Button Style="{StaticResource ModernButtonStyle}" Margin="0,0,0,8" Click="BtnResetDefaults_Click">
                                <TextBlock Text="↺ Khôi phục mặc định" FontSize="11"/>
                            </Button>
                            <Button Style="{StaticResource PrimaryButtonStyle}" Click="BtnSaveClose_Click">
                                <TextBlock Text="✓ Lưu &amp; Đóng" FontSize="12"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Right Content Area -->
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,20,24,20">
                    <Grid>
                        <!-- ================= TAB 1: MÀN HÌNH & VỊ TRÍ ================= -->
                        <StackPanel x:Name="PanelDisplay" Visibility="Visible">
                            <TextBlock Text="Màn hình &amp; Vị trí hiển thị" Foreground="#FFFFFF" FontSize="18" FontWeight="Bold" Margin="0,0,0,4"/>
                            <TextBlock Text="Tùy chỉnh vị trí của Dynamic Island trên các màn hình máy tính." Foreground="#858595" FontSize="12" Margin="0,0,0,18"/>

                            <!-- Card 1: Chọn màn hình -->
                            <Border Style="{StaticResource SettingCardBorder}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Màn hình hiển thị" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock Text="Chọn màn hình mà bạn muốn Dynamic Island hiển thị." Foreground="#808092" FontSize="11" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <ComboBox x:Name="CmbMonitors" Grid.Column="1" Width="200" Height="30" SelectionChanged="CmbMonitors_SelectionChanged"/>
                                </Grid>
                            </Border>

                            <!-- Card 2: Khoảng cách từ đỉnh -->
                            <Border Style="{StaticResource SettingCardBorder}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Khoảng cách từ đỉnh màn hình (Top Offset)" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="13"/>
                                            <TextBlock Text="Điều chỉnh khoảng cách từ mép trên cùng của màn hình xuống Island." Foreground="#808092" FontSize="11" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="#232332" CornerRadius="5" Padding="8,3,8,3">
                                            <TextBlock x:Name="LblTopOffset" Text="3 px" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12"/>
                                        </Border>
                                    </Grid>
                                    <Slider x:Name="SliderTopOffset" Grid.Row="1" Margin="0,14,0,0" Minimum="0" Maximum="60" Value="3" Style="{StaticResource ModernSliderStyle}" ValueChanged="SliderTopOffset_ValueChanged"/>
                                </Grid>
                            </Border>

                            <!-- Card 3: Độ lệch ngang (Horizontal Offset) -->
                            <Border Style="{StaticResource SettingCardBorder}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Độ lệch theo phương ngang (Horizontal Offset)" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="13"/>
                                            <TextBlock Text="Mặc định là 0 px (Chính giữa màn hình). Có thể chỉnh sang trái hoặc phải." Foreground="#808092" FontSize="11" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="#232332" CornerRadius="5" Padding="8,3,8,3">
                                            <TextBlock x:Name="LblHorizontalOffset" Text="0 px" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12"/>
                                        </Border>
                                    </Grid>
                                    <Slider x:Name="SliderHorizontalOffset" Grid.Row="1" Margin="0,14,0,10" Minimum="-600" Maximum="600" Value="0" Style="{StaticResource ModernSliderStyle}" ValueChanged="SliderHorizontalOffset_ValueChanged"/>
                                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Style="{StaticResource ModernButtonStyle}" Padding="10,4,10,4" Margin="0,0,6,0" Click="BtnQuickOffsetLeft_Click">
                                            <TextBlock Text="Lệch trái (-180px)" FontSize="10"/>
                                        </Button>
                                        <Button Style="{StaticResource ModernButtonStyle}" Padding="10,4,10,4" Margin="0,0,6,0" Click="BtnQuickOffsetCenter_Click">
                                            <TextBlock Text="🎯 Căn giữa (0px)" FontSize="10"/>
                                        </Button>
                                        <Button Style="{StaticResource ModernButtonStyle}" Padding="10,4,10,4" Click="BtnQuickOffsetRight_Click">
                                            <TextBlock Text="Lệch phải (+180px)" FontSize="10"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Card 4: Luôn hiển thị trên cùng -->
                            <Border Style="{StaticResource SettingCardBorder}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Luôn hiển thị trên cùng (Always on Top)" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock Text="Giữ Dynamic Island luôn nổi trên mọi cửa sổ và ứng dụng đang mở." Foreground="#808092" FontSize="11" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <CheckBox x:Name="ChkAlwaysOnTop" Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" IsChecked="True" Click="ChkAlwaysOnTop_Click"/>
                                </Grid>
                            </Border>

                            <!-- Card 5: Khóa vị trí (Lock Position) -->
                            <Border Style="{StaticResource SettingCardBorder}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Khóa vị trí (Lock Position)" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock Text="Cố định Dynamic Island tại vị trí hiện tại, ngăn việc vô tình kéo di chuyển đảo bằng chuột." Foreground="#808092" FontSize="11" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <CheckBox x:Name="ChkLockPosition" Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" IsChecked="False" Click="ChkLockPosition_Click"/>
                                </Grid>
                            </Border>

                            <!-- Card 5: Tự động ẩn (Auto-Hide) -->
                            <Border Style="{StaticResource SettingCardBorder}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Tự động ẩn (Auto-Hide)" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="13"/>
                                            <TextBlock Text="Ẩn viên thuốc vào cạnh trên màn hình. Rê chuột lên viền trên cùng để hiện lại." Foreground="#808092" FontSize="11" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ChkAutoHide" Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" IsChecked="False" Click="ChkAutoHide_Click"/>
                                    </Grid>
                                    <Grid Grid.Row="1" Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                            <TextBlock Text="Thời gian chờ trước khi ẩn:" Foreground="#A0A0B2" FontSize="11" Margin="0,0,0,4"/>
                                            <Slider x:Name="SliderAutoHideDelay" Minimum="0.5" Maximum="4.0" Value="1.5" SmallChange="0.5" LargeChange="0.5" Style="{StaticResource ModernSliderStyle}" ValueChanged="SliderAutoHideDelay_ValueChanged"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="#232332" CornerRadius="5" Padding="8,3,8,3" VerticalAlignment="Center">
                                            <TextBlock x:Name="LblAutoHideDelay" Text="1.5 giây" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12"/>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- ================= TAB 2: GIAO DIỆN & KÍCH THƯỚC ================= -->
                        <StackPanel x:Name="PanelAppearance" Visibility="Collapsed">
                            <TextBlock Text="Giao diện &amp; Kích thước" Foreground="#FFFFFF" FontSize="18" FontWeight="Bold" Margin="0,0,0,4"/>
                            <TextBlock Text="Tùy biến hình dáng, độ bo tròn, màu sắc và hiệu ứng thị giác." Foreground="#858595" FontSize="12" Margin="0,0,0,18"/>

                            <!-- Card 1: Kích thước Idle -->
                            <Border Style="{StaticResource SettingCardBorder}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Độ rộng ở chế độ chờ (Idle Width)" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="13"/>
                                            <TextBlock Text="Độ rộng viên thuốc mặc định khi không mở rộng." Foreground="#808092" FontSize="11" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="#232332" CornerRadius="5" Padding="8,3,8,3">
                                            <TextBlock x:Name="LblIdleWidth" Text="190 px" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12"/>
                                        </Border>
                                    </Grid>
                                    <Slider x:Name="SliderIdleWidth" Grid.Row="1" Margin="0,14,0,0" Minimum="150" Maximum="280" Value="190" Style="{StaticResource ModernSliderStyle}" ValueChanged="SliderIdleWidth_ValueChanged"/>
                                </Grid>
                            </Border>

                            <!-- Card 2: Kích thước Expanded -->
                            <Border Style="{StaticResource SettingCardBorder}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Độ rộng khi mở rộng (Expanded Width)" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="13"/>
                                            <TextBlock Text="Độ rộng của Dynamic Island khi bấm mở chi tiết trình phát nhạc." Foreground="#808092" FontSize="11" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="#232332" CornerRadius="5" Padding="8,3,8,3">
                                            <TextBlock x:Name="LblExpandedWidth" Text="400 px" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12"/>
                                        </Border>
                                    </Grid>
